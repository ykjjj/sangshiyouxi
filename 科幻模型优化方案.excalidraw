                         "type":  "text",
                         "x":  584,
                         "y":  204,
                         "width":  340,
                         "height":  24,
                         "strokeColor":  "#0A0A0A",
                         "opacity":  100,
                         "text":  "② 枪械科幻化（7 把）",
                         "fontSize":  20,
                         "fontFamily":  2,
                         "groupIds":  [
                                          "g-gun"
                                      ],
                         "createdAt":  "2026-10-09T10:38:27.860Z",
