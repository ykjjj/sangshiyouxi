                         "backgroundColor":  "#FFFFFF"
                     },
                     {
                         "id":  "mv0u17sgoab0q4o79o",
                         "type":  "text",
                         "x":  64,
                         "y":  204,
                         "width":  300,
                         "height":  24,
                         "strokeColor":  "#0A0A0A",
                         "opacity":  100,
                         "text":  "① 人物科幻化",
                         "fontSize":  20,
                         "fontFamily":  2,
                         "groupIds":  [
                                          "g-char"
                                      ],
                         "createdAt":  "2026-10-09T10:38:27.860Z",
                         "updatedAt":  "2026-10-09T10:38:27.860Z",
                         "version":  1,
                         "textAlign":  "left"
                     },
                     {
                         "id":  "mv0u17sgj50dmtpz9vn",
                         "type":  "text",
                         "x":  64,
                         "y":  248,
                         "width":  432,
                         "height":  76,
                         "strokeColor":  "#404040",
                         "opacity":  100,
                         "text":  "· 玩家手臂 → 机械义体：装甲板 + 发光关节 + 能量导管\n· 丧尸精英 / Boss：装甲发光纹路、能量核心、义眼\n· 新增科幻材质：能量青 / 等离子紫 / 纳米深灰",
                         "fontSize":  16,
                         "fontFamily":  2,
                         "groupIds":  [
                                          "g-char"
                                      ],
                         "createdAt":  "2026-10-09T10:38:27.860Z",
                         "updatedAt":  "2026-10-09T10:38:27.860Z",
                         "version":  1,
                         "textAlign":  "left"
                     },
                     {
                         "id":  "mv0u17sgrraegr6e9",
