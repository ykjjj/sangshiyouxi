                         "height":  36,
                         "strokeColor":  "#0A0A0A",
                         "opacity":  100,
                         "text":  "科幻风模型优化方案 · VOXEL ZOMBIE",
                         "fontSize":  28,
                         "fontFamily":  2,
                         "createdAt":  "2026-10-09T10:38:27.859Z",
                         "updatedAt":  "2026-10-09T10:38:27.859Z",
                         "version":  1,
                         "textAlign":  "left"
                     },
                     {
                         "id":  "mv0u17sgcxqhb1ixu",
                         "type":  "text",
                         "x":  40,
                         "y":  100,
                         "width":  900,
                         "height":  56,
                         "strokeColor":  "#404040",
                         "opacity":  100,
                         "text":  "目标：为人物、7 把枪械与 7 件近战武器做科幻化重制——能量材质、发光纹路、悬浮瞄具与光刃。\n设计语言参考主流科幻射击游戏（见下方灵感参考）。",
                         "fontSize":  16,
                         "fontFamily":  2,
                         "createdAt":  "2026-10-09T10:38:27.859Z",
                         "updatedAt":  "2026-10-09T10:38:27.859Z",
                         "version":  1,
                         "textAlign":  "left"
                     },
                     {
                         "id":  "mv0u17sgbx8at5uppyu",
                         "type":  "rectangle",
                         "x":  40,
                         "y":  180,
                         "width":  480,
                         "height":  290,
