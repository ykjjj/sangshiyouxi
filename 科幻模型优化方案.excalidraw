                         "version":  1,
                         "textAlign":  "left"
                     },
                     {
                         "id":  "mv0u17sgoc91vihl2k",
                         "type":  "text",
                         "x":  584,
                         "y":  248,
                         "width":  432,
                         "height":  97,
                         "strokeColor":  "#404040",
                         "opacity":  100,
                         "text":  "· 全枪通用：顶部能量导轨、悬浮全息瞄具、能量弹匣\n· 左轮：等离子弹巢 6 孔发光\n· 狙击：全息镜组 + 能量制退器\n· 轻机枪：能量弹箱发光带 + 排能管",
                         "fontSize":  16,
                         "fontFamily":  2,
                         "groupIds":  [
                                          "g-gun"
                                      ],
                         "createdAt":  "2026-10-09T10:38:27.860Z",
                         "updatedAt":  "2026-10-09T10:38:27.860Z",
                         "version":  1,
                         "textAlign":  "left"
                     },
